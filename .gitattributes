# Normalise line endings in the repository; check out native on Windows.
* text=auto

# Files that run inside the Linux containers must keep LF.
*.sh              text eol=lf
Dockerfile        text eol=lf
*.conf            text eol=lf
Makefile          text eol=lf

*.png             binary
*.ico             binary
*.ipynb           binary

# Test fixtures are sample files from the wild: keep their bytes exactly as
# they arrived, CRLF and BOM included - that is part of what they test.
api/tests/fixtures_data.csv -text
