# --- Working material, not part of the application --------------------------
# Design exploration and its sample data. Paths are anchored to the repo root
# so the bundled default logo (api/src/moexcharts/assets/wm.png) and the test
# fixture (api/tests/fixtures_data.csv) are still tracked.
/chart.ipynb
/data.csv
/newplot.png
/wm.png
/_to_delete/
/moex-charts.zip

# Chart exports and saved presets land here during normal use.
/out/
*.png.tmp
