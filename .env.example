# Copy to .env and adjust for the target machine:  cp .env.example .env

# ---------------------------------------------------------------- networking
# Port the UI is served on:  http://localhost:8080
WEB_PORT=8080

# ------------------------------------------------------- MOEX ISS connection
# Corporate TLS interception makes certificate validation fail for
# iss.moex.com. Setting this to false disables verification for ISS requests.
CHARTS_MOEX_VERIFY_SSL=false

# Better than the line above when the corporate root CA is available: drop the
# PEM at ./certs/corp-root-ca.pem, uncomment the api `volumes:` block in
# docker-compose.yml, and set the line below (verification stays on).
#CHARTS_MOEX_CA_BUNDLE=/etc/ssl/corp-ca.crt

CHARTS_MOEX_BASE_URL=https://iss.moex.com/iss

# If outbound traffic must go through a proxy:
#HTTPS_PROXY=http://proxy.corp:3128
#HTTP_PROXY=http://proxy.corp:3128
#NO_PROXY=localhost,127.0.0.1

# --------------------------------------------------- Nexus-proxied registries
# Base images, pulled through the internal Docker proxy.
#PYTHON_IMAGE=nexus.corp:8083/python:3.12-slim
#NGINX_IMAGE=nexus.corp:8083/nginx:1.27-alpine

# Python packages, pulled through the internal PyPI proxy.
#PIP_INDEX_URL=https://nexus.corp/repository/pypi-proxy/simple
#PIP_TRUSTED_HOST=nexus.corp

# Debian packages (only libnss3 is needed, for server-side PNG export).
#APT_MIRROR=http://nexus.corp/repository/debian-proxy

# ---------------------------------------------------------------- guard rails
CHARTS_MAX_CANDLES=20000
CHARTS_TIMEZONE=Europe/Moscow
